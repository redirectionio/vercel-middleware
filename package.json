{
    "name": "@redirection.io/vercel-middleware",
    "version": "0.5.1",
    "description": "Vercel Edge Middleware for redirection.io",
    "main": "dist/middleware.js",
    "license": "MIT",
    "private": false,
    "type": "module",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "rslib build",
        "dev": "rslib build --watch"
    },
    "exports": {
        ".": {
            "require": "./dist/middleware.js",
            "import": "./dist/middleware.mjs",
            "types": "./dist/middleware.d.ts"
        },
        "./middleware": {
            "require": "./dist/middleware.js",
            "import": "./dist/middleware.mjs",
            "types": "./dist/middleware.d.ts"
        },
        "./next": {
            "require": "./dist/next.js",
            "import": "./dist/next.mjs",
            "types": "./dist/next.d.ts"
        },
        "./instrumentation": {
            "require": "./dist/instrumentation.js",
            "import": "./dist/instrumentation.mjs",
            "types": "./dist/instrumentation.d.ts"
        }
    },
    "dependencies": {
        "@redirection.io/redirectionio": "^3.0.0",
        "@vercel/edge": "^1.1.2",
        "@vercel/functions": "^1.4.1"
    },
    "devDependencies": {
        "@rslib/core": "^0.20.0",
        "@types/node": "^25.2.2",
        "glob": "^13.0.6",
        "next": "^14.2.13",
        "prettier": "3.3.3",
        "typescript": "^5.4.5"
    },
    "peerDependencies": {
        "next": ">= 14.0.0"
    },
    "peerDependenciesMeta": {
        "next": {
            "optional": true
        }
    }
}
