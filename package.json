{
    "name": "vercel-middleware",
    "version": "0.5.2",
    "description": "Vercel Edge Middleware for redirection.io",
    "private": true,
    "workspaces": {
        "packages": [
            "packages/*",
            "apps/*"
        ]
    },
    "packageManager": "yarn@4.14.1",
    "scripts": {
        "dev": "turbo run dev",
        "build": "turbo run build",
        "build:packages": "turbo run build --filter=\"packages/*\"",
        "build:examples": "turbo run build --filter=\"./apps/*\"",
        "start:examples": "turbo run start --filter=\"./apps/*\" --daemon",
        "lint": "turbo run lint",
        "format": "turbo run format",
        "types": "turbo run types",
        "test:e2e": "turbo run test:e2e",
        "publish-packages": "yarn build:packages && changeset publish",
        "changeset-version": "changeset version"
    },
    "devDependencies": {
        "@changesets/cli": "^2.31.0",
        "oxfmt": "catalog:",
        "oxlint": "catalog:",
        "playwright": "^1.60",
        "turbo": "^2.9.6",
        "typescript": "catalog:"
    }
}
