{
    "name": "@redirection.io/vercel-middleware",
    "version": "0.5.2",
    "description": "Vercel Edge Middleware for redirection.io",
    "main": "dist/middleware.js",
    "license": "MIT",
    "type": "module",
    "files": [
        "dist"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/redirectionio/vercel-middleware"
    },
    "homepage": "https://redirection.io",
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "lint": "oxlint --config ../../.oxlintrc.json",
        "lint:fix": "oxlint --fix --config ../../.oxlintrc.json",
        "format": "oxfmt -c ../../.oxfmtrc.json",
        "format:check": "oxfmt -c ../../.oxfmtrc.json --check",
        "types": "tsc --noEmit"
    },
    "exports": {
        ".": {
            "types": "./dist/middleware.d.ts",
            "import": "./dist/middleware.js",
            "require": "./dist/middleware.cjs"
        },
        "./middleware": {
            "types": "./dist/middleware.d.ts",
            "import": "./dist/middleware.js",
            "require": "./dist/middleware.cjs"
        },
        "./next": {
            "types": "./dist/next.d.ts",
            "import": "./dist/next.js",
            "require": "./dist/next.cjs"
        },
        "./instrumentation": {
            "types": "./dist/instrumentation.d.ts",
            "import": "./dist/instrumentation.js",
            "require": "./dist/instrumentation.cjs"
        },
        "./webpack": {
            "types": "./dist/webpack.d.ts",
            "import": "./dist/webpack.mjs",
            "require": "./dist/webpack.cjs"
        }
    },
    "dependencies": {
        "@redirection.io/redirectionio": "^3.3.0",
        "@vercel/edge": "^1.1.2",
        "@vercel/functions": "^1.4.1"
    },
    "devDependencies": {
        "@types/node": "^25.2.2",
        "glob": "^13.0.6",
        "next": "^14.2.13",
        "oxfmt": "catalog:",
        "oxlint": "catalog:",
        "tsup": "^8.5.1",
        "typescript": "catalog:"
    },
    "peerDependencies": {
        "next": ">= 14.0.0"
    },
    "peerDependenciesMeta": {
        "next": {
            "optional": true
        }
    }
}
